# 仅本地联调 /api/ocr 时需要；线上请在 Vercel 项目里配置同名环境变量
# DeepSeek 开放平台（deepseek-flash 支持图片）
OCR_VISION_BASE_URL=https://api.deepseek.com
OCR_VISION_MODEL=deepseek-flash
OCR_VISION_API_KEY=
OCR_ACCESS_TOKEN=change-me-to-a-long-random-string

# 备选：Gemini / OpenAI
# OCR_VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OCR_VISION_MODEL=gemini-2.5-flash
# OCR_VISION_BASE_URL=https://api.openai.com/v1
# OCR_VISION_MODEL=gpt-4o-mini
